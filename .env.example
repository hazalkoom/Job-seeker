# Copy to .env. Never commit .env or share your bot/password values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Candidate fit. Bachelor/Computer Science degree requirements are NOT used as a rejection rule.
MAX_REQUIRED_EXPERIENCE_YEARS=2
REQUIRE_FULL_DESCRIPTION_FOR_MATCH=true
MIN_MATCH_SCORE=70
MAX_POSTING_AGE_DAYS=7
REQUEST_TIMEOUT_SECONDS=18
NOTIFY_REVIEW_CANDIDATES=true
REVIEW_DIGEST_SIZE=5

# Optional personal details for referral drafts; edit the summary to match your real CV.
CANDIDATE_DISPLAY_NAME=
CANDIDATE_SUMMARY=Junior backend/full-stack developer based in Egypt. Experience with Python, Django, FastAPI, Node.js, REST APIs, databases, Docker, and practical software projects.
CANDIDATE_LINKEDIN_URL=
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_CV_URL=

# Existing job sources.
ENABLE_REMOTEOK=true
ENABLE_REMOTIVE=true
ENABLE_HIMALAYAS=true
ENABLE_JOBICY=true
ENABLE_ARBEITNOW=true
ENABLE_GOOGLE_JOBS=true
SERPAPI_API_KEY=
GOOGLE_JOBS_FIXED_QUERY=junior backend developer OR junior full stack developer OR software engineer Egypt
GOOGLE_JOBS_ROTATING_QUERIES=junior Node.js developer Egypt;junior Python developer Egypt;junior Django developer Egypt;junior FastAPI developer Egypt;junior Angular developer Egypt;entry level software engineer Egypt;remote junior backend developer worldwide;remote junior Python developer;remote junior Node.js developer;junior AI application engineer Egypt

# International APIs (no API keys). Keep Nomado24 title/tag searches entry-level focused.
ENABLE_EUROPEAN_TECH_OPPORTUNITIES=true
EUROPEAN_TECH_OPPORTUNITIES_MAX_PAGES=3
ENABLE_NOMADO24=true
NOMADO24_LANGUAGE=en
NOMADO24_MAX_PAGES=1
NOMADO24_SEARCH_TERMS=junior;entry level;graduate;internship;trainee;no experience;junior backend;junior python

# Company ATS boards. Only use verified official slugs; no guessed IDs.
ENABLE_GREENHOUSE=true
GREENHOUSE_BOARDS=
ENABLE_LEVER=true
LEVER_SITES=
ENABLE_ASHBY=true
ASHBY_BOARDS=
ENABLE_CAREER_PAGES=true
CAREER_PAGES=

# Email alerts are optional; use a Gmail App Password, never your regular password.
ENABLE_EMAIL_ALERTS=false
EMAIL_ALERTS_IMAP_HOST=imap.gmail.com
EMAIL_ALERTS_IMAP_PORT=993
EMAIL_ALERTS_USERNAME=
EMAIL_ALERTS_PASSWORD=
EMAIL_ALERTS_MAILBOX=INBOX
EMAIL_ALERTS_LOOKBACK_DAYS=14
EMAIL_ALERTS_MAX_MESSAGES=300

# Public feeds. Keep source attribution in displayed notifications.
ENABLE_RSS_FEEDS=true
RSS_FEEDS=We Work Remotely Backend|https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss;We Work Remotely Full Stack|https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss;Startup Jobs Remote Engineering|https://startup.jobs/feeds/jobs?role=engineering&workplace=remote

# Local database; by default this folder's jobs.sqlite3 is used.
# DATABASE_PATH=/absolute/path/to/jobs.sqlite3
