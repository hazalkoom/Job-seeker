# Telegram BotFather token and the chat ID you already obtained.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only confirmed matches score >= this threshold. Keep freshness at seven days.
MIN_MATCH_SCORE=70
MAX_POSTING_AGE_DAYS=7
REQUEST_TIMEOUT_SECONDS=18
NOTIFY_REVIEW_CANDIDATES=false

# General remote job sources
ENABLE_REMOTEOK=true
ENABLE_REMOTIVE=true
ENABLE_HIMALAYAS=true
ENABLE_JOBICY=true
ENABLE_ARBEITNOW=true

# Company career systems. Populate only after checking the company's official careers URL.
# Format: Company Display Name:board-token;Another Company:another-token
ENABLE_GREENHOUSE=true
GREENHOUSE_BOARDS=
ENABLE_LEVER=true
LEVER_SITES=
ENABLE_ASHBY=true
ASHBY_BOARDS=

# Official career pages that expose schema.org JobPosting JSON-LD.
# Format: Company Name|https://company.example/careers;Another Company|https://another.example/jobs
ENABLE_CAREER_PAGES=true
CAREER_PAGES=

# Optional. Defaults to ./jobs.sqlite3
# DATABASE_PATH=/absolute/path/to/jobs.sqlite3


# Import job alerts you subscribe to in WUZZUF, LinkedIn, Indeed, and Bayt.
# This reads your own mailbox via IMAP; it does not scrape logged-in job-board pages.
# Gmail: use an app password (requires 2-Step Verification), not your account password.
ENABLE_EMAIL_ALERTS=false
EMAIL_ALERTS_IMAP_HOST=imap.gmail.com
EMAIL_ALERTS_IMAP_PORT=993
EMAIL_ALERTS_USERNAME=
EMAIL_ALERTS_PASSWORD=
EMAIL_ALERTS_MAILBOX=INBOX
EMAIL_ALERTS_LOOKBACK_DAYS=14
EMAIL_ALERTS_MAX_MESSAGES=300

# Optional public RSS/Atom feeds from job boards or company career sites.
# Format: Feed Label|https://example.com/jobs.rss;Another Feed|https://example.com/jobs.xml
ENABLE_RSS_FEEDS=true
RSS_FEEDS=
